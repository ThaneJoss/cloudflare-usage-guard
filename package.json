{
  "name": "cloudflare-usage-guard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev --var ALLOWED_ORIGINS:http://localhost:5173",
    "build": "node scripts/build.mjs",
    "build:frontend": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json && vite build",
    "build:worker": "tsc -p tsconfig.worker.json",
    "audit:dependencies": "pnpm audit --audit-level high --registry=https://registry.npmjs.org",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "check:bundle": "node scripts/check-bundle.mjs",
    "lint": "oxlint .",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.node.json && tsc -p tsconfig.test.json && tsc -p tsconfig.test-node.json && tsc -p tsconfig.test-worker.json",
    "test": "pnpm test:unit && pnpm test:worker-runtime",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:worker-runtime": "vitest run --config vitest.worker.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "test:watch": "vitest",
    "worker:types": "wrangler types worker/worker-configuration.d.ts",
    "worker:types:check": "wrangler types worker/worker-configuration.d.ts --check",
    "worker:dry-run": "wrangler deploy --dry-run --secrets-file .dev.vars.example",
    "deploy:worker": "wrangler deploy",
    "preview:worker": "wrangler versions upload",
    "deploy": "pnpm deploy:worker",
    "preview": "vite preview"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@11.14.0",
  "dependencies": {
    "cloudflare": "7.1.0",
    "jose": "^6.2.4",
    "lucide-react": "^1.27.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.8",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^29.1.1",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  }
}
