{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cloudflare-usage-guard",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-07-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/v1", "/v1/*", "/health"]
  },
  "routes": [
    {
      "pattern": "cloudflare.thanejoss.com",
      "custom_domain": true
    }
  ],
  "secrets": {
    "required": ["CF_ACCOUNT_ID", "CF_API_TOKEN", "POLICY_AUD"]
  },
  "vars": {
    "TEAM_DOMAIN": "https://thanejoss.cloudflareaccess.com"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  }
}
